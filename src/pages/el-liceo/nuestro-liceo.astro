        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center p-6">
            <div class="text-4xl font-bold text-institutional-gold-dark mb-2">+90</div>
            <p class="text-gray-600 font-medium">Años de Historia</p>
          </div>
          <div class="text-center p-6">
            <div class="text-4xl font-bold text-institutional-gold-dark mb-2">+500</div>
            <p class="text-gray-600 font-medium">Estudiantes</p>
          </div>
          <div class="text-center p-6">
            <div class="text-4xl font-bold text-institutional-gold-dark mb-2">+50</div>
            <p class="text-gray-600 font-medium">Funcionarios</p>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
