---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto - Liceo San José del Carmen">
  <div class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <div class="bg-gradient-to-r from-institutional-blue to-institutional-blue-dark text-white py-16">
        <div class="max-w-4xl mx-auto px-4">
          <nav class="text-sm text-white/60 mb-4">
            <a href="/" class="hover:text-white">Inicio</a>
            <span class="mx-2">/</span>
            <span class="text-institutional-gold">Contacto</span>
          </nav>
          <h1 class="text-4xl font-bold">Contacto</h1>
          <p class="text-white/70 mt-2 text-lg">Estamos aquí para ayudarte</p>
        </div>
      </div>
      <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm border border-gray-200">
              <div class="w-12 h-12 bg-institutional-blue/10 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-institutional-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-dark">Dirección</h3>
                <p class="text-gray-600 text-sm mt-1">Av. Principal 1234, Comuna, Región</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm border border-gray-200">
              <div class="w-12 h-12 bg-institutional-blue/10 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-institutional-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-dark">Teléfono</h3>
                <p class="text-gray-600 text-sm mt-1">+56 9 XXXX XXXX</p>
                <p class="text-gray-600 text-sm">+56 72 XXXX XXX</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm border border-gray-200">
              <div class="w-12 h-12 bg-institutional-blue/10 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-institutional-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-dark">Correo Electrónico</h3>
                <p class="text-gray-600 text-sm mt-1">contacto@liceosanjose.cl</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-sm border border-gray-200">
              <div class="w-12 h-12 bg-institutional-blue/10 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-institutional-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-dark">Horarios de Atención</h3>
                <p class="text-gray-600 text-sm mt-1">Lunes a Viernes: 8:00 - 17:00 hrs</p>
                <p class="text-gray-600 text-sm">Secretaría: 8:30 - 16:00 hrs (horario continuado)</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-200">
            <h3 class="text-xl font-bold text-institutional-blue mb-4">Envíanos un mensaje</h3>
            <form class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre completo *</label>
                <input type="text" id="name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institutional-blue focus:border-transparent outline-none transition-all" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico *</label>
                <input type="email" id="email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institutional-blue focus:border-transparent outline-none transition-all" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                <input type="tel" id="phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institutional-blue focus:border-transparent outline-none transition-all" />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Mensaje *</label>
                <textarea id="message" rows="4" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-institutional-blue focus:border-transparent outline-none transition-all"></textarea>
              </div>
              <button type="submit" class="w-full bg-institutional-blue text-white font-semibold px-6 py-3 rounded-lg hover:bg-institutional-blue-dark transition-colors cursor-pointer">
                Enviar Mensaje
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
