---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Post {
  usuario: string;
  url: string;
  descripcion: string;
}

const posts: Post[] = [
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example1", descripcion: "Ceremonia de Abanderamiento 2026" },
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example2", descripcion: "Feria de Ciencias Regional" },
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example3", descripcion: "Talleres extraprogramáticos" },
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example4", descripcion: "Selección de Fútbol del Liceo" },
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example5", descripcion: "Jornada de Puertas Abiertas" },
  { usuario: "@liceosanjosedelcarmen", url: "https://www.instagram.com/p/example6", descripcion: "Celebración Fiestas Patrias" },
];
---

<Layout title="Galería - Liceo San José del Carmen">
  <div class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <div class="bg-gradient-to-r from-institutional-blue to-institutional-blue-dark text-white py-16">
        <div class="max-w-6xl mx-auto px-4">
          <nav class="text-sm text-white/60 mb-4">
            <a href="/" class="hover:text-white">Inicio</a>
            <span class="mx-2">/</span>
            <span class="text-institutional-gold">Galería</span>
          </nav>
          <h1 class="text-4xl font-bold">Galería</h1>
          <p class="text-white/70 mt-2 text-lg">Revive los mejores momentos del liceo a través de nuestras fotos y videos</p>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex items-center gap-2 mb-8 text-sm">
          <button class="px-4 py-2 bg-institutional-blue text-white rounded-lg font-medium">Todas</button>
          <button class="px-4 py-2 bg-gray-light text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-colors">Fotos</button>
          <button class="px-4 py-2 bg-gray-light text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-colors">Videos</button>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-all"
            >
              <div class="aspect-square bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center relative">
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm rounded-lg px-2.5 py-1 text-xs font-medium text-gray-700 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-[#E4405F]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
                  Instagram
                </div>
              </div>
              <div class="p-4">
                <p class="text-sm font-medium text-dark truncate">{post.descripcion}</p>
                <p class="text-xs text-gray-500 mt-1">{post.usuario}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="text-center mt-10">
          <a
            href="https://www.instagram.com/liceosanjosedelcarmen"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-[#833AB4] via-[#FD1D1D] to-[#F77737] text-white font-semibold px-6 py-3 rounded-lg hover:opacity-90 transition-opacity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
            Ver más en Instagram
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
