---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Matrículas - Liceo San José del Carmen">
  <div class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <div class="bg-gradient-to-r from-institutional-blue to-institutional-blue-dark text-white py-16">
        <div class="max-w-4xl mx-auto px-4">
          <nav class="text-sm text-white/60 mb-4">
            <a href="/" class="hover:text-white">Inicio</a>
            <span class="mx-2">/</span>
            <span class="text-institutional-gold">Matrículas</span>
          </nav>
          <h1 class="text-4xl font-bold">Matrículas 2027</h1>
          <p class="text-white/70 mt-2 text-lg">Proceso de admisión y matrícula para el año escolar</p>
        </div>
      </div>
      <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="bg-institutional-gold/10 border border-institutional-gold/30 rounded-xl p-8 mb-8">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 bg-institutional-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-institutional-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-institutional-blue mb-2">Proceso de Admisión</h2>
              <p class="text-gray-700 mb-4">
                El proceso de admisión para el año escolar 2027 se realizará a través del 
                Sistema de Admisión Escolar (SAE) del Ministerio de Educación. A continuación, 
                te informamos sobre las fechas y requisitos importantes.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="px-4 py-2 bg-institutional-blue text-white text-sm font-medium rounded-lg">Pre-Kínder a 4° Medio</span>
                <span class="px-4 py-2 bg-white text-institutional-blue text-sm font-medium rounded-lg border border-institutional-blue">Particular Subvencionado</span>
                <span class="px-4 py-2 bg-white text-institutional-blue text-sm font-medium rounded-lg border border-institutional-blue">Gratuito</span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
            <div class="text-3xl font-bold text-institutional-blue mb-1">Agosto</div>
            <p class="text-sm text-gray-600">Postulaciones SAE</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
            <div class="text-3xl font-bold text-institutional-blue mb-1">Octubre</div>
            <p class="text-sm text-gray-600">Resultados de asignación</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
            <div class="text-3xl font-bold text-institutional-blue mb-1">Diciembre</div>
            <p class="text-sm text-gray-600">Proceso de matrícula</p>
          </div>
        </div>

        <div class="bg-gray-light rounded-xl p-8">
          <h2 class="text-xl font-bold text-institutional-blue mb-4">Requisitos para la Matrícula</h2>
          <div class="grid md:grid-cols-2 gap-6 text-sm text-gray-700">
            <div>
              <h3 class="font-semibold text-dark mb-2">Documentos Necesarios:</h3>
              <ul class="space-y-2">
                <li class="flex items-start gap-2">• <span>Certificado de nacimiento del estudiante</span></li>
                <li class="flex items-start gap-2">• <span>Informe de notas del año anterior</span></li>
                <li class="flex items-start gap-2">• <span>Certificado de alumno regular</span></li>
                <li class="flex items-start gap-2">• <span>Fotocopia de carnet de identidad del estudiante (si tiene)</span></li>
                <li class="flex items-start gap-2">• <span>Fotocopia de carnet de identidad del apoderado</span></li>
              </ul>
            </div>
            <div>
              <h3 class="font-semibold text-dark mb-2">Información Adicional:</h3>
              <ul class="space-y-2">
                <li class="flex items-start gap-2">• <span>Ficha de matrícula completa y firmada</span></li>
                <li class="flex items-start gap-2">• <span>Certificado médico (si aplica)</span></li>
                <li class="flex items-start gap-2">• <span>2 fotografías tamaño carnet</span></li>
                <li class="flex items-start gap-2">• <span>Informe de personalidad (para estudiantes nuevos)</span></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 text-center">
          <p class="text-gray-600 mb-4">¿Tienes dudas sobre el proceso de admisión?</p>
          <a href="/contacto" class="inline-flex items-center gap-2 bg-institutional-blue text-white font-semibold px-6 py-3 rounded-lg hover:bg-institutional-blue-dark transition-colors">
            Contáctanos
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
