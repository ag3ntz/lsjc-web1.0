---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

interface Abanderado {
  name: string;
  position: string;
  curso: string;
  symbol: string;
}

const abanderados: Abanderado[] = [
  { name: "Valentina Paz Muñoz", position: "Abanderada", curso: "4° Medio A", symbol: "Bandera Nacional" },
  { name: "Benjamín Andrés Soto", position: "Primer Escoltas", curso: "4° Medio A", symbol: "Bandera Nacional" },
  { name: "Catalina Sofía Rivas", position: "Segunda Escolta", curso: "4° Medio B", symbol: "Bandera Nacional" },
  { name: "Matías Ignacio Pérez", position: "Abanderado", curso: "3° Medio A", symbol: "Bandera del Liceo" },
  { name: "Javiera Andrea Morales", position: "Primera Escolta", curso: "3° Medio A", symbol: "Bandera del Liceo" },
  { name: "Cristóbal Esteban Vega", position: "Segundo Escolta", curso: "3° Medio B", symbol: "Bandera del Liceo" },
];
---

<Layout title="Abanderados 2026 - Liceo San José del Carmen">
  <div class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <div class="bg-gradient-to-r from-institutional-blue to-institutional-blue-dark text-white py-16">
        <div class="max-w-5xl mx-auto px-4">
          <nav class="text-sm text-white/60 mb-4">
            <a href="/" class="hover:text-white">Inicio</a>
            <span class="mx-2">/</span>
            <span class="text-white/80">Comunidad Educativa</span>
            <span class="mx-2">/</span>
            <span class="text-institutional-gold">Abanderados 2026</span>
          </nav>
          <h1 class="text-4xl font-bold">Abanderados 2026</h1>
          <p class="text-white/70 mt-2 text-lg">Estudiantes destacados que representan con orgullo a nuestra institución</p>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {abanderados.map((a) => (
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden text-center hover:shadow-md transition-shadow">
              <div class="bg-gradient-to-r from-institutional-blue to-institutional-gold h-2"></div>
              <div class="p-6">
                <div class="w-20 h-20 bg-gradient-to-br from-institutional-blue to-institutional-blue-dark rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-2xl font-bold text-white">
                    {a.name.split(" ").map(n => n[0]).slice(0, 2).join("")}
                  </span>
                </div>
                <h3 class="text-lg font-bold text-dark">{a.name}</h3>
                <p class="text-sm font-semibold text-institutional-gold-dark">{a.position}</p>
                <p class="text-sm text-gray-600">{a.curso}</p>
                <span class="inline-block mt-3 px-3 py-1 bg-institutional-blue/10 text-institutional-blue text-xs font-medium rounded-full">
                  {a.symbol}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
